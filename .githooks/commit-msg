#!/bin/sh
# Rejects commit messages that don't follow Conventional Commits 1.0.0.
first_line=$(head -n 1 "$1")

case "$first_line" in
  Merge\ *|Revert\ *|fixup!\ *|squash!\ *) exit 0 ;;
esac

pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9_-]+\))?!?: .{1,72}$'
if ! echo "$first_line" | grep -Eq "$pattern"; then
  cat >&2 <<MSG
Commit message does not follow Conventional Commits:

  <type>(<optional scope>): <description>

Types:  feat fix docs style refactor perf test build ci chore revert
Scopes: accounts config dashboard projects statuscheck ui
Example: feat(projects): add category filter to search

Yours: $first_line
MSG
  exit 1
fi
